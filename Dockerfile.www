# syntax=docker/dockerfile:1

FROM node:22-bookworm-slim AS build

LABEL org.opencontainers.image.source="https://github.com/uwais/naviG8r"
ARG RELEASE_SHA=unknown
WORKDIR /src

COPY package.json package-lock.json ./
COPY apps/www/package.json ./apps/www/package.json

RUN npm ci

COPY apps/www ./apps/www

RUN npm run build --workspace apps/www

FROM nginx:1.27-alpine

ARG RELEASE_SHA=unknown
ENV RELEASE_SHA=${RELEASE_SHA}

COPY --from=build /src/apps/www/dist /usr/share/nginx/html
COPY docker/www/nginx.conf /etc/nginx/conf.d/default.conf
COPY docker/www/entrypoint.sh /docker-entrypoint.d/99-navig8r-www.sh

RUN chmod +x /docker-entrypoint.d/99-navig8r-www.sh

EXPOSE 10000
