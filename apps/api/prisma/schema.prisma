// Postgres persistence for logistics-mvp (optional; FILE mode remains default).
// Apply: DATABASE_URL="postgresql://..." npx prisma db push

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Carrier {
  id               String  @id
  name             String
  createdAtUtcMs   BigInt
  inactiveAtUtcMs  BigInt?
  inactiveReason   String?
}

model Organization {
  id                   String  @id
  kind                 String
  displayName          String
  kycStatus            String
  createdAtUtcMs       BigInt
  payoutContactId      String?
  payoutFundAccountId  String?
  inactiveAtUtcMs      BigInt?
  inactiveReason       String?
}

model UserRow {
  id               String  @id
  phone            String
  fullName         String
  createdAtUtcMs   BigInt
  inactiveAtUtcMs  BigInt?
  inactiveReason   String?
}

model Membership {
  userId           String
  orgId            String
  role             String
  createdAtUtcMs   BigInt
  inactiveAtUtcMs  BigInt?
  inactiveReason   String?

  assignments MembershipRoleAssignment[]
  @@id([userId, orgId])
  @@index([orgId])
}

model Vehicle {
  @@index([orgId])
  id                    String  @id
  orgId                 String
  registrationNumber    String
  vehicleClass          String
  capacityKg            Int
  createdAtUtcMs        BigInt
  inactiveAtUtcMs       BigInt?
  inactiveReason        String?
}

model DriverProfileRow {
  userId             String  @id
  orgId              String
  primaryVehicleId   String
  createdAtUtcMs     BigInt
  inactiveAtUtcMs    BigInt?
  inactiveReason     String?
}

model OtpChallengeRow {
  id              String @id
  phone           String
  code            String
  status          String
  expiresAtUtcMs  BigInt
  createdAtUtcMs  BigInt
}

model AuthSessionRow {
  id               String @id
  userId           String
  createdAtUtcMs   BigInt
  expiresAtUtcMs   BigInt
  revokedAtUtcMs   BigInt?
}

model AnchorTripRow {
  startedAtUtcMs BigInt?
  startedByUserId String?
  completedAtUtcMs BigInt?
  completedByUserId String?
  @@index([carrierId])
  id               String  @id
  carrierId        String
  originCity       String
  destCity         String
  origin           Json?
  destination      Json?
  windowStart      String
  windowEnd        String
  vehicleClass     String
  capacityKg       Int
  reservedKg       Int
  status           String
  createdAtUtcMs   BigInt
  lastLiveLocation Json?
  inactiveAtUtcMs  BigInt?
  inactiveReason   String?
}

model PaymentRow {
  id                 String  @id
  shipmentId         String
  amountPaise        Int
  status             String
  provider           String
  providerRef        String
  razorpayOrderId    String?
  razorpayPaymentId  String?
  createdAtUtcMs     BigInt
  updatedAtUtcMs     BigInt
  inactiveAtUtcMs    BigInt?
  inactiveReason     String?
}

model ShipmentRow {
  podAcceptedAtUtcMs BigInt?
  podAcceptedByUserId String?
  acceptedAtUtcMs BigInt?
  acceptedByUserId String?
  externalLoadId String?
  externalSource String?
  integrationConnectionId String?
  metadata Json?
  integrationSequence Int?
  @@index([customerOrgId, status])
  @@index([carrierId, status])
  id                             String  @id
  anchorTripId                   String
  carrierId                      String
  customerOrgId                  String?
  customerOrgName                String
  bookedByPhone                  String?
  bookedByUserId                 String?
  weightKg                       Int
  pickupAddress                  String
  dropAddress                    String
  pickup                         Json?
  drop                           Json?
  status                         String
  grossPaise                     Int
  commissionPaise                Int
  netToCarrierPaise             Int
  paymentId                     String
  podAtUtcMs                    BigInt?
  podSubmittedByUserId          String?
  podNotes                      String?
  firstPayoutEligibleAtUtcMs    BigInt?
  payoutBatchCutoffUtcMs        BigInt?
  createdAtUtcMs                BigInt
  updatedAtUtcMs                BigInt
  inactiveAtUtcMs               BigInt?
  inactiveReason                String?
}

model LedgerLineRow {
  id                          String  @id
  shipmentId                  String
  carrierId                   String
  grossPaise                  Int
  commissionPaise             Int
  netToCarrierPaise           Int
  podAtUtcMs                  BigInt
  firstPayoutEligibleAtUtcMs  BigInt
  payoutBatchCutoffUtcMs      BigInt
  status                      String
  createdAtUtcMs              BigInt
  paidAtUtcMs                 BigInt?
  inactiveAtUtcMs             BigInt?
  inactiveReason              String?
}

model PayoutBatchRow {
  id                      String @id
  cutoffUtcMs             BigInt
  createdAtUtcMs          BigInt
  totalNetToCarrierPaise  Int
  lineIds                 Json // string[]
  provider                String? // "BOOKKEEPING" | "RAZORPAYX"
  transfers               Json? // PayoutTransfer[]
}

model Role {
  key String @id
  permissions RolePermission[]
  assignments MembershipRoleAssignment[]
}
model Permission {
  key String @id
  roles RolePermission[]
}
model RolePermission {
  roleKey String
  permissionKey String
  role Role @relation(fields: [roleKey], references: [key])
  permission Permission @relation(fields: [permissionKey], references: [key])
  @@id([roleKey, permissionKey])
}
model MembershipRoleAssignment {
  userId String
  orgId String
  roleKey String
  membership Membership @relation(fields: [userId, orgId], references: [userId, orgId])
  role Role @relation(fields: [roleKey], references: [key])
  @@id([userId, orgId, roleKey])
}
// Marker distinguishes an explicitly revoked membership from a legacy un-migrated row.
model AuthorizationMigration {
  key String @id
}
model AuditEvent {
  id String @id
  actorUserId String
  actorOrganizationId String
  effectiveActorId String?
  action String
  resourceType String
  resourceId String
  previousState String?
  newState String?
  reasonCode String?
  requestId String
  timestamp BigInt
  source String
  @@index([actorOrganizationId, timestamp])
  @@index([resourceType, resourceId])
}
// Existing integration models were FILE-only; retain their existing serialized shape.
model IntegrationState {
  key String @id
  data Json
}
